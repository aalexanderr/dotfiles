[[block]]
block = "custom"
# active airvpn* NetworkManager connection(s). net_vpn icon when up, net_vpn_off when down.
# none -> Idle, exactly 1 -> Good (green), >1 -> Critical (red).
# custom block has no format_alt, so left-click cycles compact <-> verbose:
#   compact (default): icon only; names shown only when >1 are active (always red).
#   verbose (clicked):  icon + name, or "none" when disconnected.
json = true
interval = 5
format = "$icon$text"
cycle = [
'''
conns=$(nmcli -t -f NAME connection show --active | grep "^airvpn")
n=$(test -n "$conns" && echo "$conns" | wc -l || echo 0)
names=$(echo "$conns" | sed 's/^airvpn-//' | paste -sd " ")
if [ "$n" -eq 0 ]; then echo '{"icon":"net_vpn_off","text":"","state":"Idle"}';
elif [ "$n" -eq 1 ]; then echo '{"icon":"net_vpn","text":"","state":"Good"}';
else echo "{\"icon\":\"net_vpn\",\"text\":\" $names\",\"state\":\"Critical\"}"; fi
''',
'''
conns=$(nmcli -t -f NAME connection show --active | grep "^airvpn")
n=$(test -n "$conns" && echo "$conns" | wc -l || echo 0)
names=$(echo "$conns" | sed 's/^airvpn-//' | paste -sd " ")
if [ "$n" -eq 0 ]; then echo '{"icon":"net_vpn_off","text":" none","state":"Idle"}';
elif [ "$n" -eq 1 ]; then echo "{\"icon\":\"net_vpn\",\"text\":\" $names\",\"state\":\"Good\"}";
else echo "{\"icon\":\"net_vpn\",\"text\":\" $names\",\"state\":\"Critical\"}"; fi
''',
]

