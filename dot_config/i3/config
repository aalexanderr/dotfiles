set $flamingo #f2cdcd
set $pink #f5c2e7
set $mauve #cba6f7
set $red #f38ba8
set $maroon #eba0ac
set $peach #fab387
set $yellow #f9e2af
set $green #a6e3a1
set $teal #94e2d5
set $sky #89dceb
set $sapphire #74c7ec
set $blue #89b4fa
set $lavender #b4befe
set $text #cdd6f4
set $subtext1 #bac2de
set $subtext0 #a6adc8
set $overlay2 #9399b2
set $overlay1 #7f849c
set $overlay0 #6c7086
set $surface2 #585b70
set $surface1 #45475a
set $surface0 #313244
set $base #1e1e2ee5
set $mantle #181825
set $crust #11111b
#
client.focused           $lavender $base $text  $rosewater $lavender
client.focused_inactive  $overlay0 $base $text  $rosewater $overlay0
client.unfocused         $overlay0 $base $text  $rosewater $overlay0
client.urgent            $peach    $base $peach $overlay0  $peach
client.placeholder       $overlay0 $base $text  $overlay0  $overlay0
client.background        $base
#
default_border pixel
gaps outer 0
gaps inner 0
# single containre in workspace will not have gaps
smart_gaps off
default_border pixel 1

### variables
#############
set $sup Mod4
set $alt Mod1
# vi
set $vleft h
set $vdown j
set $vup k
set $vright l
# arrows
set $aleft Left
set $adown Down
set $aup Up
set $aright Right
# workspaces
set $num_of_workspaces 10
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

set $term kitty
set $term-alt i3-sensible-terminal
# application launcher
set $menu ~/.local/bin/bemenu-path
set $desktop ~/.local/bin/bemenu-desktop
set $power ~/.local/bin/bemenu-power

set $lockcmd ~/.local/bin/i3lock-run

set $psf $(xdg-user-dir PICTURES)/ps_$(date +"%Y%m%d%H%M%S").png

set $refresh_i3status killall -SIGUSR1 i3status

font pango:"DejaVuSansM Nerd Font Mono, Font Awesome 6 Free"
#font "DejaVuSansM Nerd Font Mono, Font Awesome 6 Free"

### Key bindings
################
# Start a terminal
bindsym $sup+Return exec $term
bindsym $sup+Shift+Return exec $term-alt
# Kill focused window
bindsym $sup+Shift+q kill
# Start your launcher
bindsym $sup+d exec --no-startup-id $menu
bindsym $sup+Shift+d exec --no-startup-id $desktop
bindsym $sup+p exec --no-startup-id $power
# Use Mouse+$sup to drag floating windows to their wanted position
# Despite the name, also works for non-floating windows.
floating_modifier $sup
# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar
# i3-only:
bindsym $sup+Shift+r restart
# Reload the configuration file
bindsym $sup+Shift+c reload
# Exit sway (logs you out of your Wayland session)
bindsym $sup+Shift+e exec "i3-nagbar -t warning -m 'Exit i3 and end X session?' -B 'Yes, exit i3' 'i3-msg exit'"

### Moving around:
##################
# Move your focus around
bindsym $sup+$vleft focus left
bindsym $sup+$vdown focus down
bindsym $sup+$vup focus up
bindsym $sup+$vright focus right
# Or use $sup+[up|down|left|right]
bindsym $sup+$aleft focus left
bindsym $sup+$adown focus down
bindsym $sup+$aup focus up
bindsym $sup+$aright focus right
# Move the focused window with the same, but add Shift
bindsym $sup+Shift+$vleft move left
bindsym $sup+Shift+$vright move right
bindsym $sup+Shift+$vdown move down
bindsym $sup+Shift+$vup move up
# Ditto, with arrow keys
bindsym $sup+Shift+$aleft move left
bindsym $sup+Shift+$aright move right
bindsym $sup+Shift+$adown move down
bindsym $sup+Shift+$aup move up

### Workspaces:
###############
# Switch to workspace
bindsym $sup+1 workspace number $ws1
bindsym $sup+2 workspace number $ws2
bindsym $sup+3 workspace number $ws3
bindsym $sup+4 workspace number $ws4
bindsym $sup+5 workspace number $ws5
bindsym $sup+6 workspace number $ws6
bindsym $sup+7 workspace number $ws7
bindsym $sup+8 workspace number $ws8
bindsym $sup+9 workspace number $ws9
bindsym $sup+0 workspace number $ws10
# Move focused container to workspace
bindsym $sup+Shift+1 move container to workspace number $ws1
bindsym $sup+Shift+2 move container to workspace number $ws2
bindsym $sup+Shift+3 move container to workspace number $ws3
bindsym $sup+Shift+4 move container to workspace number $ws4
bindsym $sup+Shift+5 move container to workspace number $ws5
bindsym $sup+Shift+6 move container to workspace number $ws6
bindsym $sup+Shift+7 move container to workspace number $ws7
bindsym $sup+Shift+8 move container to workspace number $ws8
bindsym $sup+Shift+9 move container to workspace number $ws9
bindsym $sup+Shift+0 move container to workspace number $ws10
# switching to non existent sworkspaces from gentoo wiki
bindsym $sup+alt+$aleft          exec i3-msg -pt get_workspaces | ~/.local/bin/workspace.gawk -v move_type="left"  -v num_of_workspaces=$num_of_workspaces
bindsym $sup+alt+$aright         exec i3-msg -pt get_workspaces | ~/.local/bin/workspace.gawk -v move_type="right" -v num_of_workspaces=$num_of_workspaces
bindsym $sup+control+alt+$aleft  exec i3-msg -pt get_workspaces | ~/.local/bin/workspace.gawk -v move_type="container_left"  -v num_of_workspaces=$num_of_workspaces
bindsym $sup+control+alt+$aright exec i3-msg -pt get_workspaces | ~/.local/bin/workspace.gawk -v move_type="container_right" -v num_of_workspaces=$num_of_workspaces

### Layout stuff:
#################
bindsym $sup+b splith
bindsym $sup+v splitv
# Switch the current container between different layout styles
bindsym $sup+s layout stacking
bindsym $sup+w layout tabbed
bindsym $sup+e layout toggle split
# Make the current focus fullscreen
bindsym $sup+f fullscreen
# Toggle the current focus between tiling and floating mode
bindsym $sup+Shift+space floating toggle
# Swap focus between the tiling area and the floating area
bindsym $sup+space focus mode_toggle
# Move focus to the parent container
bindsym $sup+a focus parent
# Focus the child container
#bindsym $sup+d focus child

### Scratchpad:
###############
# Move the currently focused window to the scratchpad
bindsym $sup+Shift+minus move scratchpad
# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
bindsym $sup+minus scratchpad show

### Resizing containers:
########################
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $vleft resize shrink width 10 px or 10 ppt
    bindsym $vdown resize grow height 10 px or 10 ppt
    bindsym $vup resize shrink height 10 px or 10 ppt
    bindsym $vright resize grow width 10 px or 10 ppt
    # Ditto, with arrow keys
    bindsym $aleft resize shrink width 10 px or 10 ppt
    bindsym $adown resize grow height 10 px or 10 ppt
    bindsym $aup resize shrink height 10 px or 10 ppt
    bindsym $aright resize grow width 10 px or 10 ppt
    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $sup+r mode "default"
}
bindsym $sup+r mode "resize"

