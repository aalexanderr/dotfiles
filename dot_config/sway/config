
# Config for sway
#
# Read `man 5 sway` for a complete reference.

# Visual settings
default_border pixel
gaps outer 1
gaps inner 1
# single containre in workspace will not have gaps
smart_gaps on
default_border pixel 1

#hide mouse after 1s inactivty
seat * hide_cursor 1000

# idle imhibition
for_window [class="^.*"] inhibit_idle fullscreen
for_window [app_id="^.*"] inhibit_idle fullscreen

# restart dbus session as it mightve been started too early
exec --no-startup-id dbus-update-activation-environment --all
exec systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK I3SOCK XCURSOR_SIZE XCURSOR_THEME

exec  --no-startup-id mako
exec  --no-startup-id foot -s

### Variables
#
set $sup Mod4
set $alt Mod1

# vim navigation
set $vleft h
set $vdown j
set $vup k
set $vright l
# arrows naviation
set $aleft Left
set $adown Down
set $aup Up
set $aright Right

set $num_of_workspaces 10
set $term footclient
# application launcher
set $menu ~/.config/bemenu/bemenu-path
set $desktop ~/.config/bemenu/bemenu-desktop
set $power ~/.config/bemenu/bemenu-power

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output * bg $HOME/.config/sway/wall.jpg fill
output eDP-1 resolution 1920x1080@60.020hz pos 0 0
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
exec swayidle -w \
         timeout 300 'swaylock' \
         timeout 600 'swaymsg "output * dpms off"' \
	 lock 'swaylock' \
         timeout 15 'if pgrep -x swaylock; then swaymsg "output * dpms off"; fi' \
	 resume 'swaymsg "output * dpms on"' \
         before-sleep 'swaylock'\
	 idlehint 250

#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

### Input configuration
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.

# TODO: us,pl when added to system
input "type:keyboard" {
    xkb_layout us
    xkb_options grp:alt_shift_toggle
    # in ms
    # repeat_dealy 100
    # characters per second
    # repeat_rate 5
}

input "type:touchpad" {
    # disable-while-typing
    dwt enabled
    # disable-while-trackpointing
    dwtp enabled
    tap enabled
    drag enabled
    # disable zones on touchpad for non-LMB
    click_method clickfinger
    # why is this not defaul everywhere :/
    natural_scroll enabled
    middle_emulation enabled
}

input "type:pointer" {
    dwt enabled
}

# T480
input "1739:0:Synaptics_TM3276-022" {
}
input "2:10:TPPS/2_IBM_TrackPoint" {
    dwt enabled
    scroll_factor 0.2
    pointer_accel +0.2
    # accel_profile "flat"
}

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $sup+Return exec $term

    # Kill focused window
    bindsym $sup+Shift+q kill

    # Start your launcher
    bindsym $sup+d exec $menu
    bindsym $sup+Shift+d exec $desktop
    bindsym $sup+p exec $power

    # Drag floating windows by holding down $sup and left mouse button.
    # Resize them with right mouse button + $sup.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $sup normal

    # Reload the configuration file
    bindsym $sup+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $sup+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $sup+$vleft focus left
    bindsym $sup+$vdown focus down
    bindsym $sup+$vup focus up
    bindsym $sup+$vright focus right
    # Or use $sup+[up|down|left|right]
    bindsym $sup+$aleft focus left
    bindsym $sup+$adown focus down
    bindsym $sup+$aup focus up
    bindsym $sup+$aright focus right

    # Move the focused window with the same, but add Shift
    bindsym $sup+Shift+$vleft move left
    bindsym $sup+Shift+$vright move right
    bindsym $sup+Shift+$vdown move down
    bindsym $sup+Shift+$vup move up
    # Ditto, with arrow keys
    bindsym $sup+Shift+$aleft move left
    bindsym $sup+Shift+$aright move right
    bindsym $sup+Shift+$adown move down
    bindsym $sup+Shift+$aup move up

#
# Workspaces:
#
    # Switch to workspace
    bindsym $sup+1 workspace number 1
    bindsym $sup+2 workspace number 2
    bindsym $sup+3 workspace number 3
    bindsym $sup+4 workspace number 4
    bindsym $sup+5 workspace number 5
    bindsym $sup+6 workspace number 6
    bindsym $sup+7 workspace number 7
    bindsym $sup+8 workspace number 8
    bindsym $sup+9 workspace number 9
    bindsym $sup+0 workspace number 10
    # Move focused container to workspace
    bindsym $sup+Shift+1 move container to workspace number 1
    bindsym $sup+Shift+2 move container to workspace number 2
    bindsym $sup+Shift+3 move container to workspace number 3
    bindsym $sup+Shift+4 move container to workspace number 4
    bindsym $sup+Shift+5 move container to workspace number 5
    bindsym $sup+Shift+6 move container to workspace number 6
    bindsym $sup+Shift+7 move container to workspace number 7
    bindsym $sup+Shift+8 move container to workspace number 8
    bindsym $sup+Shift+9 move container to workspace number 9
    bindsym $sup+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.

# switching to non existent sworkspaces from gentoo wiki
    bindsym $sup+alt+$aleft          exec swaymsg -pt get_workspaces | gawk -f ~/.config/sway/workspace.gawk -v move_type="left"  -v num_of_workspaces=$num_of_workspaces
    bindsym $sup+alt+$aright         exec swaymsg -pt get_workspaces | gawk -f ~/.config/sway/workspace.gawk -v move_type="right" -v num_of_workspaces=$num_of_workspaces
    bindsym $sup+control+alt+$aleft  exec swaymsg -pt get_workspaces | gawk -f ~/.config/sway/workspace.gawk -v move_type="container_left"  -v num_of_workspaces=$num_of_workspaces
    bindsym $sup+control+alt+$aright exec swaymsg -pt get_workspaces | gawk -f ~/.config/sway/workspace.gawk -v move_type="container_right" -v num_of_workspaces=$num_of_workspaces
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $sup+b or $sup+v, for horizontal and vertical splits
    # respectively.
    bindsym $sup+b splith
    bindsym $sup+v splitv

    # Switch the current container between different layout styles
    bindsym $sup+s layout stacking
    bindsym $sup+w layout tabbed
    bindsym $sup+e layout toggle split

    # Make the current focus fullscreen
    bindsym $sup+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $sup+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $sup+space focus mode_toggle

    # Move focus to the parent container
    bindsym $sup+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $sup+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $sup+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $vleft resize shrink width 10px
    bindsym $vdown resize grow height 10px
    bindsym $vup resize shrink height 10px
    bindsym $vright resize grow width 10px
    # Ditto, with arrow keys
    bindsym $aleft resize shrink width 10px
    bindsym $adown resize grow height 10px
    bindsym $aup resize shrink height 10px
    bindsym $aright resize grow width 10px
    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $sup+r mode "resize"

#
# Special keys
#
