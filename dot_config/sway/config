set $alt Mod1
# vi
set $vleft h
set $vdown j
set $vup k
set $vright l
# arrows
set $aleft Left
set $adown Down
set $aup Up
set $aright Right
# workspaces
set $num_of_workspaces 10
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

set $term kitty
set $term-alt footclient
# application launcher
set $menu ~/.local/bin/bemenu-path
set $desktop ~/.local/bin/bemenu-desktop
set $power ~/.local/bin/bemenu-power

set $lockcmd swaylock

set $psf $(xdg-user-dir PICTURES)/ps_$(date +"%Y%m%d%H%M%S").png

