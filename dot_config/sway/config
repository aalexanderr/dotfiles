#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
bar {
    position top
    #font pango:"Monospace"
    #font pango:"Font Awesome 6 Free"
    # idk why - pango rendered font awesome normally but using pango here didnt work
    font "DejaVu Sans Mono, Font Awesome 6 Free"
    #font pango:"Material Icons"
    #swaybar_command waybar
    #swaybar_command yambar

    # When the status_command prints a new line to stdout, swaybar updates.
    # The default just shows the current date and time.
    # status_command while date +'%Y-%m-%d %X'; do sleep 1; done
    #status_command while $HOME/.config/sway/bar.sh; do sleep 1; done
    #status_command while $HOME/.config/sway/bar.sh; do sleep 1; done
    status_command "i3status-rs ~/.config/i3status-rs/config.toml"
    separator_symbol " "
    colors {
        separator #f2f2e3
        background #241b30e5
        statusline #f2f2e3
        # <colorclass> <border> <background> <text>
        focused_workspace #2a6dafe5 #2a6dafe5 #f2f2e3
        active_workspace #241b30e5 #241b30e5 #f2f2e3
        inactive_workspace #241b30e5 #241b30e5 #f2f2e3
        urgent_workspace #9a0048e5 #9a0048e5 #f2f2e3
    }
}

